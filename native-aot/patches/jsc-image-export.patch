diff --git a/Source/JavaScriptCore/Scripts/tests/builtin-source-stamp-unittest.py b/Source/JavaScriptCore/Scripts/tests/builtin-source-stamp-unittest.py
new file mode 100644
index 000000000..5425c02ec
--- /dev/null
+++ b/Source/JavaScriptCore/Scripts/tests/builtin-source-stamp-unittest.py
@@ -0,0 +1,50 @@
+#!/usr/bin/env python3
+
+import hashlib
+from pathlib import Path
+import re
+import sys
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'wkbuiltins'))
+
+from builtins_generate_combined_implementation import BuiltinsCombinedImplementationGenerator
+from builtins_model import BuiltinsCollection
+
+
+class BuiltinSourceStampTests(unittest.TestCase):
+    def generate(self, source):
+        model = BuiltinsCollection(framework_name='JavaScriptCore')
+        model.parse_builtins_file('Stamp.js', '/*\n * Copyright (C) 2026 Apple Inc. All rights reserved.\n * Redistribution\n */\n' + source)
+        output = BuiltinsCombinedImplementationGenerator(model).generate_output()
+        code = re.search(r's_JSCCombinedCode\[\] = \{ (.*?) \};', output).group(1)
+        data = bytes(int(value) for value in code.split(', '))
+        source_hash = int(re.search(r's_JSCCombinedCodeHash = 0x([0-9a-f]+)ULL;', output).group(1), 16)
+        stamp = int(re.search(r's_JSCCombinedCodeStamp = 0x([0-9a-f]+)ULL;', output).group(1), 16)
+        return data, source_hash, stamp
+
+    def test_hashes_exact_emitted_bytes(self):
+        data, source_hash, _ = self.generate('function value() { return "caf\u00e9"; }\n')
+        self.assertIn(233, data)
+        self.assertEqual(source_hash, int.from_bytes(hashlib.sha256(data).digest()[:8], 'big'))
+
+    def test_same_length_edit_changes_stamp(self):
+        before, _, old_stamp = self.generate('function value() { return 17; }\n')
+        after, _, new_stamp = self.generate('function value() { return 19; }\n')
+        self.assertEqual(len(before), len(after))
+        self.assertNotEqual(old_stamp, new_stamp)
+
+    def test_stripped_creation_directive_changes_stamp(self):
+        before, old_hash, old_stamp = self.generate('function value() { return 17; }\n')
+        after, new_hash, new_stamp = self.generate('@alwaysInline\nfunction value() { return 17; }\n')
+        self.assertEqual(before, after)
+        self.assertEqual(old_hash, new_hash)
+        self.assertNotEqual(old_stamp, new_stamp)
+
+    def test_generation_is_reproducible(self):
+        source = 'function value() { return 17; }\n'
+        self.assertEqual(self.generate(source), self.generate(source))
+
+
+if __name__ == '__main__':
+    unittest.main()
