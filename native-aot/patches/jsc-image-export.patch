+TEST(WTF, FixedAddressEmptyStringInitialization)
+{
+    auto* fixedAddress = StringImpl::emptyAsStaticStringImpl();
+    auto* canonical = StringImpl::empty();
+    EXPECT_EQ(reinterpret_cast<uintptr_t>(canonical), bmalloc::StaticRegion::startOf(bmalloc::StaticRegion::Arena::Bss) + bmalloc::StaticRegion::offsetOfEmptyStringInBss);
+    EXPECT_EQ(static_cast<StringImpl&>(*fixedAddress).length(), 0u);
+    EXPECT_TRUE(canonical->isStatic());
+    EXPECT_TRUE(canonical->isAtom());
+    EXPECT_TRUE(canonical->is8Bit());
+    EXPECT_TRUE(canonical->hasHash());
+    EXPECT_EQ(emptyString().impl(), canonical);
+    EXPECT_EQ(emptyAtom().impl(), canonical);
+    EXPECT_FALSE(emptyString().isNull());
+    EXPECT_FALSE(emptyAtom().isNull());
+
+    auto hash = canonical->hash();
+    std::array<StringImpl*, 4> results { };
+    std::array<std::thread, 4> threads;
+    for (size_t i = 0; i < threads.size(); ++i) {
+        threads[i] = std::thread([&, i] {
+            StringImpl::initializeEmptyString();
+            bmalloc::StaticRegion::mapBss();
+            results[i] = i % 2 ? emptyAtom().impl() : emptyString().impl();
+        });
+    }
+    for (auto& thread : threads)
+        thread.join();
+    for (auto* result : results)
+        EXPECT_EQ(result, canonical);
+    EXPECT_EQ(canonical->hash(), hash);
+}
